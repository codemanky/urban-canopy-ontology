@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dwc:  <http://rs.tdwg.org/dwc/terms/> .
@prefix atree: <http://austin.gov/ontology/trees#> .
@prefix dc:   <http://purl.org/dc/elements/1.1/> .

# =============================================================================
# Austin Tree Species Ontology
# Source: Austin Tree Inventory (data.austintexas.gov)
# Purpose: Normalize fragmented SPECIES string variants to canonical
#          scientific names, enabling consistent cross-dataset queries.
# =============================================================================

<http://austin.gov/ontology/trees>
    rdf:type owl:Ontology ;
    dc:title "Austin Urban Tree Species Ontology" ;
    dc:description "Maps all observed common-name variants in the Austin Tree Inventory to canonical scientific names (DwC), enabling ontology-augmented querying across fragmented city datasets." ;
    dc:creator "Austin SRE Data Pipeline" ;
    owl:versionInfo "1.0.0" .

# =============================================================================
# GENUS-LEVEL CLASSES (parents for multi-species groups)
# =============================================================================

atree:Quercus
    rdf:type owl:Class ;
    skos:prefLabel "Oak (genus)"@en ;
    dwc:scientificName "Quercus" ;
    skos:altLabel "Oak"@en ;
    skos:note "Catch-all for ambiguous 'Oak' references that cannot be resolved to species level."@en .

atree:Celtis
    rdf:type owl:Class ;
    skos:prefLabel "Hackberry (genus)"@en ;
    dwc:scientificName "Celtis" ;
    skos:altLabel "Hackberry"@en .

atree:Ulmus
    rdf:type owl:Class ;
    skos:prefLabel "Elm (genus)"@en ;
    dwc:scientificName "Ulmus" ;
    skos:altLabel "Elm"@en .

# =============================================================================
# QUERCUS (OAKS) — Species Level
# =============================================================================

atree:SouthernLiveOak
    rdf:type owl:Class ;
    rdfs:subClassOf atree:Quercus ;
    skos:prefLabel "Southern Live Oak"@en ;
    dwc:scientificName "Quercus virginiana" ;
    # Variants observed in Austin Tree Inventory (data.austintexas.gov)
    skos:altLabel "Southern Live Oak"@en ;
    skos:altLabel "Oak, Live (Southern)"@en ;
    skos:altLabel "Oak, Texas Live (Escarpment)"@en ;
    skos:altLabel "Escarpment Live Oak"@en ;
    skos:altLabel "Live Oak"@en ;
    skos:altLabel "Oak Tree"@en ;
    skos:altLabel "Big Oak"@en ;
    skos:altLabel "Scrub Oak"@en ;
    skos:note "Most common urban tree in Austin. Multiple naming conventions used across departments."@en .

atree:TexasRedOak
    rdf:type owl:Class ;
    rdfs:subClassOf atree:Quercus ;
    skos:prefLabel "Texas Red Oak"@en ;
    dwc:scientificName "Quercus texana" ;
    skos:altLabel "Texas Red Oak"@en ;
    skos:altLabel "Oak, Texas Red"@en ;
    skos:altLabel "Red Oak"@en ;
    skos:note "Also listed as Quercus buckleyi in some taxonomies."@en .

atree:ShumardOak
    rdf:type owl:Class ;
    rdfs:subClassOf atree:Quercus ;
    skos:prefLabel "Shumard Oak"@en ;
    dwc:scientificName "Quercus shumardii" ;
    skos:altLabel "Shumard Oak"@en ;
    skos:altLabel "Shumard Red Oak"@en .

atree:BurOak
