# =============================================================================
# PATCH: altLabels on existing classes for still-unmapped variant strings
# =============================================================================

# Cottonwood bare label → EasternCottonwood
atree:EasternCottonwood
    skos:altLabel "Cottonwood"@en .

# Pistache, Chinese → ChinesePistache (already exists)
atree:ChinesePistache
    skos:altLabel "Pistache, Chinese"@en ;
    skos:altLabel "Pistachio"@en ;
    skos:altLabel "Pistache, Texas"@en .

# Persimmon, Common → TexasPersimmon
atree:TexasPersimmon
    skos:altLabel "Persimmon, Common"@en ;
    skos:altLabel "Persimmon, Japanese"@en ;
    skos:altLabel "Japanese Persimmon"@en .

# Silktree / Mimosa, Silk Tree → SilkTree
atree:SilkTree
    skos:altLabel "Silktree"@en ;
    skos:altLabel "Mimosa, Silk Tree"@en .

# Baldcypress → BaldCypress
atree:BaldCypress
    skos:altLabel "Baldcypress"@en ;
    skos:altLabel "Cypress, Montezuma Bald"@en ;
    skos:altLabel "Montezuma Cypress"@en ;
    skos:altLabel "Cypress, Monterey"@en ;
    skos:altLabel "Monterey Cypress"@en ;
    skos:altLabel "Cypress, Italian"@en ;
    skos:altLabel "Italian Cypress"@en ;
    skos:altLabel "Cypress, Arizona"@en ;
    skos:altLabel "Arizona Cypress"@en ;
    skos:altLabel "Cypress, Bald.r"@en ;
    skos:altLabel "Cypress, Leyland"@en .

# Black Locust variants → BlackLocust
atree:BlackLocust
    skos:altLabel "Locust, Black"@en .

# Mulberry variants → Mulberry
atree:Mulberry
    skos:altLabel "Mulberry spp."@en ;
    skos:altLabel "Red Mulberry"@en ;
    skos:altLabel "Mulberry, Red"@en ;
    skos:altLabel "Mulberry, White"@en ;
    skos:altLabel "White Mulberry"@en .

# Eastern Redbud variants
atree:EasternRedbud
    skos:altLabel "Redbud species"@en ;
    skos:altLabel "Redbud, Mexican"@en ;
    skos:altLabel "Mountain Laurel"@en .

# Sycamore spp. → AmericanSycamore
atree:AmericanSycamore
    skos:altLabel "Sycamore spp."@en .

# Oak, American Live → SouthernLiveOak
