    rdfs:subClassOf atree:Quercus ;
    skos:prefLabel "Bur Oak"@en ;
    dwc:scientificName "Quercus macrocarpa" ;
    skos:altLabel "Bur Oak"@en ;
    skos:altLabel "Oak, Bur"@en ;
    skos:altLabel "Mossycup Oak"@en .

atree:ChinquapinOak
    rdf:type owl:Class ;
    rdfs:subClassOf atree:Quercus ;
    skos:prefLabel "Chinquapin Oak"@en ;
    dwc:scientificName "Quercus muehlenbergii" ;
    skos:altLabel "Chinquapin Oak"@en ;
    skos:altLabel "Oak, Chinquapin"@en ;
    skos:altLabel "Chinkapin Oak"@en .

atree:PostOak
    rdf:type owl:Class ;
    rdfs:subClassOf atree:Quercus ;
    skos:prefLabel "Post Oak"@en ;
    dwc:scientificName "Quercus stellata" ;
    skos:altLabel "Post Oak"@en ;
    skos:altLabel "Oak, Post"@en .

atree:MexicanWhiteOak
    rdf:type owl:Class ;
    rdfs:subClassOf atree:Quercus ;
    skos:prefLabel "Mexican White Oak"@en ;
    dwc:scientificName "Quercus polymorpha" ;
    skos:altLabel "Mexican White Oak"@en ;
    skos:altLabel "Oak, Mexican White (Netleaf)"@en ;
    skos:altLabel "Netleaf Oak"@en .

# =============================================================================
# ULMUS (ELMS) — Species Level
# =============================================================================

atree:CedarElm
    rdf:type owl:Class ;
    rdfs:subClassOf atree:Ulmus ;
    skos:prefLabel "Cedar Elm"@en ;
    dwc:scientificName "Ulmus crassifolia" ;
    # KEY ONTOLOGY VALUE: Two naming conventions in inventory for same species
    skos:altLabel "Cedar Elm"@en ;
    skos:altLabel "Elm, Cedar"@en ;
    skos:note "Austin Tree Inventory uses BOTH 'Cedar Elm' (3,979 rows) and 'Elm, Cedar' (4,830 rows) for the same species — a 55% undercount without ontology normalization."@en .

atree:AmericanElm
    rdf:type owl:Class ;
    rdfs:subClassOf atree:Ulmus ;
    skos:prefLabel "American Elm"@en ;
    dwc:scientificName "Ulmus americana" ;
    skos:altLabel "American Elm"@en ;
    skos:altLabel "Elm, American"@en .

